# Optional for Supabase cloud / production.
# Local development uses `npm run dev`, which injects Supabase local values automatically.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public Cloudflare Turnstile site key. Leave empty in local/test environments.
# Configure the matching secret in Supabase Auth, never in this repository.
TURNSTILE_SITE_KEY=

# Direct Postgres URL used ONLY to auto-apply schema migrations at container
# boot (see scripts/migrate-db.mjs). Not needed for local `npm run dev`, which
# applies migrations via `supabase start`. On the Supabase docker network the
# host is the db service name. Leave unset to skip auto-migration.
SUPABASE_DB_URL="postgresql://postgres:your-postgres-password@db:5432/postgres"

# --- Email / SMTP (confirmation d'inscription + mail de bienvenue) ---
USE_SMTP=false
APP_PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=My Heroes <no-reply@example.com>

# My Heroes — APP environment (Unraid).
#
# The image is GENERIC: nothing is baked at build. Every value below is read at
# RUNTIME, so the same image works for anyone — each install sets its own values
# and nobody sees another's IP or keys.
#
# Use these as the env vars of the Unraid template (Docker → Add Container) or,
# if you deploy the app as a Portainer stack instead, paste them there.

# --- Image ---------------------------------------------------------------
REGISTRY_IMAGE=docker.io/nicthien/my-heroes:latest

# --- Supabase wiring (runtime) -------------------------------------------
# Browser-facing Supabase (Kong) URL. A private/LAN value (192.168.x, 10.x,
# 172.16-31.x) flips the client onto the built-in /api/supabase proxy, so the
# browser never talks to Supabase directly.
SUPABASE_URL=http://<supabase-ip>:8000

# Anon / publishable key — public by design (shipped to every browser).
SUPABASE_ANON_KEY=<anon / publishable key from the Supabase stack>

# Server-only secret. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service role key from the Supabase stack>

# Where the server-side proxy reaches Supabase. Defaults to SUPABASE_URL.
# - App on the SAME docker network as Kong: http://kong:8000
# - App on br0 with its own IP: the Supabase LAN IP, e.g. http://<supabase-ip>:8000
SUPABASE_INTERNAL_URL=http://<supabase-ip>:8000

# --- Only if deploying as a Portainer/compose stack (not the Unraid template) ---
# Host port for the app, and the external docker network to join.
APP_PORT=3000
SUPABASE_NETWORK=supabase_default

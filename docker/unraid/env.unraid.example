# My Heroes — APP environment (Unraid).
#
# The image is GENERIC: nothing is baked at build. Every value below is read at
# RUNTIME, so the same image works for anyone — each install sets its own values
# and nobody sees another's IP or keys.
#
# Use these as the env vars of the Unraid template (Docker → Add Container) or,
# if you deploy the app as a Portainer stack instead, paste them there.

# --- Image ---------------------------------------------------------------
REGISTRY_IMAGE=docker.io/nicthien/my-heroes:latest

# --- Supabase wiring (runtime) -------------------------------------------
# Browser-facing Supabase (Kong) URL. A private/LAN value (192.168.x, 10.x,
# 172.16-31.x) flips the client onto the built-in /api/supabase proxy, so the
# browser never talks to Supabase directly.
SUPABASE_URL=http://<supabase-ip>:8000

# Anon / publishable key — public by design (shipped to every browser).
SUPABASE_ANON_KEY=<anon / publishable key from the Supabase stack>
TURNSTILE_SITE_KEY=

# Server-only secret. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service role key from the Supabase stack>

# Direct Postgres URL — used ONLY to auto-apply schema migrations at app boot.
# This is a real DB login (NOT the service role key): the postgres user + the
# POSTGRES_PASSWORD from your Supabase stack. On the SHARED docker network the
# host is the db service name (usually `db`), so no host port is published.
# Leave unset to disable auto-migration (or set MIGRATE_ON_BOOT=false).
SUPABASE_DB_URL=postgresql://postgres:<postgres-password>@db:5432/postgres
# Optional: set to false to skip the boot-time migration step entirely.
MIGRATE_ON_BOOT=true

# Where the server-side proxy reaches Supabase. Defaults to SUPABASE_URL.
# - App on the SAME docker network as Kong: http://kong:8000
# - App on br0 with its own IP: the Supabase LAN IP, e.g. http://<supabase-ip>:8000
SUPABASE_INTERNAL_URL=http://<supabase-ip>:8000

# --- Email / SMTP (signup confirmation + welcome mail) -------------------
# Master switch. Leave "false" on test servers: signup is instant, no email
# confirmation is required and no mail is sent. Set "true" to require players to
# confirm their email before they can log in (and to send the welcome email).
USE_SMTP=false
# Public URL the app is reached at (e.g. https://heroes.example.com). Used to
# build confirmation links and Open Graph / Reddit preview URLs.
# Required when USE_SMTP=true; recommended for public production deployments.
APP_PUBLIC_URL=https://<your-app-domain>
# SMTP server (your provider: Sendgrid, Mailgun, OVH, Gmail relay, etc.).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (port 465); "false" for STARTTLS (587/25).
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
# From header shown to recipients.
SMTP_FROM=My Heroes <no-reply@example.com>

# --- Only if deploying as a Portainer/compose stack (not the Unraid template) ---
# Host port for the app, and the external docker network to join.
APP_PORT=3000
SUPABASE_NETWORK=supabase_default
